# Copy to .env.local for local overrides, or set in Vercel's project settings.
# Leave empty for local dev (Vite proxies /api to localhost:5000, see vite.config.js).
# In production, set to the deployed backend's base URL, e.g. https://malla-forsa-api.up.railway.app
VITE_API_URL=

# WhatsApp number of the shop for the /demande confirmation button (international format, digits only, e.g. 21622123456). Leave empty to hide the button.
VITE_WHATSAPP_NUMBER=
