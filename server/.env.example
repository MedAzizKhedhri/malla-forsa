# Copy this file to .env and fill in the values before starting the server
# cp .env.example .env

# MongoDB connection string
# Local dev default: mongodb://127.0.0.1:27017/mallaforssa
MONGO_URI=mongodb://127.0.0.1:27017/mallaforssa

# JWT secret — use a long random string, never share it
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Server port (optional, defaults to 5000)
PORT=5000

# Environment
NODE_ENV=development

# Cloudflare R2 (S3-compatible object storage for uploaded screenshots/images)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
# Public base URL for the bucket (r2.dev dev URL or custom domain)
R2_PUBLIC_URL=

# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173
